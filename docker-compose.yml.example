services:
  dns01-stack:
    image: harianto/dns01-stack
    container_name: dns01-stack
    restart: unless-stopped
    ports:
      - "53:53"
      - "53:53/udp"
      # Preferred without a front proxy: "80:80" / "443:443".
      # 8080/8443 when Synology DSM (or similar) owns 80/443 — point Cloudflared,
      # Nginx Proxy Manager, Tailscale (TSDProxy), or Synology reverse proxy here.
      - "8080:80"
      - "8443:443"
    volumes:
      - ./data/dns01_config:/etc/acme-dns  # acme-dns config.cfg, listen address, auth zone
      - ./data/dns01_data:/var/lib/acme-dns  # SQLite DB for acme-dns accounts and TXT records
      - ./data/dns01_host:/config/host  # domains.txt edited on host or in Certs UI
      - ./data/dns01-config:/app/config:rw  # clientstorage.json and cert UI settings
      - ./data/dns01-data:/app/data:rw  # Nuxt app data root and backups
      - ./data/letsencrypt:/etc/letsencrypt  # certbot PEM output (live, staging, trash)
    environment:
      # ── System ──────────────────────────────────────────────────────────────────
      - TZ=${TZ:-UTC}
      - ADMINISTRATOR_PASSWORD=${ADMINISTRATOR_PASSWORD:-}
      # ── Backend ─────────────────────────────────────────────────────────────────
      - NUXT_ACME_DNS_CONFIG=/etc/acme-dns/config.cfg
      - ACMEDNS_URL=${ACMEDNS_URL:-http://127.0.0.1}
      - CLIENTSTORAGE_DATA=/app/config/clientstorage.json
      - NUXT_APPLICATIONS_DATA_ROOT=${NUXT_APPLICATIONS_DATA_ROOT:-/app/data}
      - DOMAINS_FILE=/config/host/domains.txt
      - CERTBOT_CONFIG_DIR=/etc/letsencrypt
      - LETSENCRYPT_EMAIL=${LETSENCRYPT_EMAIL:-admin@example.com}
      - RENEW_INTERVAL=${RENEW_INTERVAL:-12}
      - CERTS_ACME_ENABLED=${CERTS_ACME_ENABLED:-true}
      # ── Frontend ────────────────────────────────────────────────────────────────
      # Register form default — follow ACMEDNS_URL unless explicitly overridden
      - NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=${NUXT_PUBLIC_DEFAULT_ACMEDNS_URL:-${ACMEDNS_URL:-http://127.0.0.1}}
    # NET_BIND_SERVICE only needed when not running as root; omit cap_add if the process runs as root.
    cap_add:
      - NET_BIND_SERVICE

volumes:
  letsencrypt:
    name: letsencrypt
  dns01-config:
    name: dns01-config
  dns01-data:
    name: dns01-data
