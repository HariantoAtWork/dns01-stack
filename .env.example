# ── System ──────────────────────────────────────────────────────────────────

TZ=UTC

# Optional lock for the Nuxt UI + APIs. Username is always admin.
# Leave empty for open access. Set a password to require sign-in.
ADMINISTRATOR_PASSWORD=

# ── Paths (optional — Compose/Dockerfile set production defaults) ───────────
# DNS01_CONFIG=/var/lib/dns01-stack/server/config.cfg
# DNS01_CLIENTSTORAGE=/var/lib/dns01-stack/client/clientstorage.json
# DNS01_CLIENT_ROOT=/var/lib/dns01-stack/client
# DNS01_DOMAINS=/var/lib/dns01-stack/client/domains.txt
# DNS01_CERT_SETTINGS=/var/lib/dns01-stack/client/cert-settings.json
# DNS01_LETSENCRYPT=/etc/letsencrypt
# DNS01_LISTEN=0.0.0.0:53
# DNS01_SEED_ROOT=/app/seed
# DNS01_CONFIG_DEFAULT=/app/seed/server/config.cfg

# ── Backend ─────────────────────────────────────────────────────────────────

# Public identity for register/update + Register form default (unless overridden).
# Loopback or a host matching config.cfg `domain` still registers in-process.
ACMEDNS_URL=https://auth.example.org

LETSENCRYPT_EMAIL=admin@example.com
RENEW_INTERVAL=12
CERTS_ACME_ENABLED=true

# ── Frontend ────────────────────────────────────────────────────────────────

# Optional override for the Register form only (defaults to ACMEDNS_URL)
# NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=https://auth.example.org
