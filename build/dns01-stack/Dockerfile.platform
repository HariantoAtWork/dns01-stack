# Install and Nuxt build run on the host CPU. QEMU amd64 on Apple Silicon
# crashes Bun (SIGILL). The Nitro output is JS; only the runner is per-arch.
FROM --platform=$BUILDPLATFORM node:24-alpine AS bun-base
RUN apk add --no-cache bash curl unzip \
  && curl -fsSL https://bun.com/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

FROM --platform=$BUILDPLATFORM bun-base AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

FROM --platform=$BUILDPLATFORM deps AS build
COPY . .
RUN bun run build

FROM node:24-alpine AS runner
RUN apk add --no-cache bash curl unzip \
  && curl -fsSL https://bun.com/install | bash
ENV PATH="/root/.bun/bin:${PATH}"
WORKDIR /app
ENV NODE_ENV=production
ENV NITRO_HOST=0.0.0.0
ENV NUXT_ACME_DNS_CONFIG=/var/lib/dns01-stack/server/config.cfg
ENV CLIENTSTORAGE_DATA=/var/lib/dns01-stack/client/clientstorage.json
ENV NUXT_APPLICATIONS_DATA_ROOT=/var/lib/dns01-stack/client
ENV DOMAINS_FILE=/var/lib/dns01-stack/client/domains.txt
ENV CERT_SETTINGS_FILE=/var/lib/dns01-stack/client/cert-settings.json
ENV CERTBOT_CONFIG_DIR=/etc/letsencrypt
COPY --from=build /app/.output .output
COPY --from=build /app/seed/config.cfg /app/config.cfg.default
EXPOSE 53 80 443
EXPOSE 53/udp
CMD ["/bin/sh", "-c", "set -e; file=\"${CLIENTSTORAGE_DATA:?CLIENTSTORAGE_DATA is required}\"; mkdir -p \"$(dirname \"$file\")\" /var/lib/dns01-stack/server /var/lib/dns01-stack/client /etc/letsencrypt; if [ ! -s \"$file\" ]; then echo '{}' > \"$file\"; fi; exec bun .output/server/index.mjs"]
