# Dev image: Bun 1.4+ (lockfileVersion 2). Source is bind-mounted by docker-compose.dev.yml.
FROM oven/bun:1.4-alpine
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ENV HOST=0.0.0.0
ENV NITRO_HOST=0.0.0.0
EXPOSE 3000
EXPOSE 15353
EXPOSE 15353/udp
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
